{
  "name": "WebService_REST",
  "version": "1.0.0",
  "description": "Servicio REST de catálogo de productos",
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file .env --watch src/server.js",
    "start": "node --env-file .env src/server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "migrate": "node --env-file .env --watch src/server.js sequelize-cli db:migrate",
    "migrate:undo": "node --env-file=.env node_modules/.bin/sequelize-cli db:migrate:undo",
    "migrate:status": "node --env-file=.env node_modules/.bin/sequelize-cli db:migrate:status"
  },
  "keywords": [],
