  "license": "ISC",
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "sequelize-cli": "^6.6.3"
  }
}
